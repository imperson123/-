diff --git a/ggml/include/ggml-tmac.h b/ggml/include/ggml-tmac.h
index f79b6744..9af93ea6 100644
--- a/ggml/include/ggml-tmac.h
+++ b/ggml/include/ggml-tmac.h
@@ -7,6 +7,9 @@
 #include <arm_neon.h>
 typedef float16_t tmac_float_type;
 #else
+// x86/AVX2 kernels compute in float32 (_mm256_*_ps / _mm256_storeu_ps), so the
+// host-side scale buffers must be float32 too — matching the float32 codegen
+// (platform.py out_dtype). Using _Float16 here halves buffer sizes / index strides.
 typedef float tmac_float_type;
 #endif
 
