diff --git a/convert_hf_to_gguf.py b/convert_hf_to_gguf.py
index fa729c9..3ceb95d 100755
--- a/convert_hf_to_gguf.py
+++ b/convert_hf_to_gguf.py
@@ -2287,9 +2287,17 @@ class BitnetModel(Model):
                 # transform weight into TMAC_BN_0 format
                 from gguf.tmac_utils import preprocess_for_t_mac
                 data = LazyTorchTensor.to_eager(data_torch).numpy()
-                scale = np.max(np.abs(data))
-                w = np.round(data / scale + 2).astype(np.uint8)
-                data_torch = torch.from_numpy(preprocess_for_t_mac(w, scale.reshape(1), bits=2))
+                # (fandou fix) per-group (g=64) ternary quantization with GROUP scales:
+                # the runtime kernels (q_group_size=64) read one f32 scale per 64-element
+                # group, stored right after the packed data (tensor->data + k*m/8).
+                # The stock WIP code wrote a single per-tensor scale and segfaulted.
+                g = 64
+                m, k = data.shape
+                assert k % g == 0, (m, k, g)
+                xg = data.reshape(m, k // g, g)
+                sg = np.maximum(np.abs(xg).max(axis=2), 1e-5).astype(np.float32)
+                w = np.round(xg / sg[:, :, None] + 2).clip(1, 3).astype(np.uint8).reshape(m, k)
+                data_torch = torch.from_numpy(preprocess_for_t_mac(w, sg.reshape(-1), bits=2))
                 self.quantization_config["bits"] = 2
                 # self.quantization_config["group_size"] = 256
                 self.quantization_config["sym"] = True
